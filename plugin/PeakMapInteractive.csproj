<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HikingGPS</AssemblyName>
    <RootNamespace>PeakMapInteractive</RootNamespace>
    <Version>1.0.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Game assemblies are not CLS-compliant and produce a lot of noise. -->
    <NoWarn>CS0436;CS0618;MSB3277</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    The navigator artwork, built into the assembly rather than shipped beside
    it: nothing for a user to lose and nothing for a mod manager to miss. It is
    ours, drawn for this mod, which is why it can ship at all - none of PEAK's
    own art is here, and the marker icons are photographed at runtime for
    exactly that reason.
  -->
  <ItemGroup>
    <EmbeddedResource Include="assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <!--
    Game + engine assemblies, referenced in place. Private=false keeps them out
    of the build output; BepInEx resolves them at runtime from the game itself.
  -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp;Assembly-CSharp-firstpass;Newtonsoft.Json;Zorro.Core.Runtime;PhotonUnityNetworking;PhotonRealtime;Unity.Collections;Unity.Mathematics;Unity.Burst;UnityEngine;UnityEngine.CoreModule;UnityEngine.PhysicsModule;UnityEngine.TerrainModule;UnityEngine.ImageConversionModule;UnityEngine.ScreenCaptureModule;UnityEngine.InputLegacyModule;UnityEngine.AudioModule;UnityEngine.UIModule;UnityEngine.UI;Unity.TextMeshPro;UnityEngine.UIElementsModule;Unity.RenderPipelines.Universal.Runtime;Unity.RenderPipelines.Core.Runtime">
      <HintPath>$(PeakManaged)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Install into the capture clone, never into the copy you play. -->
  <Target Name="DeployToGame" AfterTargets="Build"
          Condition="'$(PeakCaptureDir)' != '' AND Exists('$(PeakCaptureDir)\BepInEx')">
    <MakeDir Directories="$(PeakCaptureDir)\BepInEx\plugins\HikingGPS" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(PeakCaptureDir)\BepInEx\plugins\HikingGPS"
          ContinueOnError="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(PeakCaptureDir)\BepInEx\plugins\HikingGPS" />
  </Target>

</Project>
